rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // 🏪 SHOP ASSETS
    match /shops/{shopId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 📦 PRODUCT IMAGES (NEW STRUCTURE)
    match /products/{shopId}/{productId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // SELLER DOCUMENTS
		match /seller_documents/{societyId}/{sellerId}/{fileName} {
      allow read, write: if request.auth != null
        && request.auth.uid == sellerId;
    }

    // 🖼 LANDING PAGE BANNERS
    // Same permissive pattern as shops/ and products/ above (any signed-in
    // user may write) rather than a Storage-side admin check - a prior
    // attempt using firestore.get() to verify the admin role here didn't
    // work as expected and isn't worth the risk of guessing again. The
    // real authorization gate is firestore.rules' `banners` collection
    // (admin-only write) - a stray uploaded image with no Firestore doc
    // pointing to it is harmless, and only the admin UI ever calls this.
    match /banners/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
